# Copy to .env in the project root for local development (not committed).
# On hosting platforms, set these as environment variables in the dashboard.

# Required: YouTube Data API v3 key (server-side only — never expose in the frontend)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Production only: comma-separated frontend origins allowed for CORS and WebSockets
# Example: https://jam.example.com,https://www.jam.example.com
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# Activate production profile on the server (disables H2 console, reduces SQL logging)
SPRING_PROFILES_ACTIVE=prod
